{
  "name": "interview-copilot-desktop",
  "version": "1.0.0",
  "description": "Stealth AI Interview Copilot Desktop App",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node src/server.js",
    "server": "node src/server.js",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amantiwaricse760-hash/CheckouAIClone.git"
  },
  "build": {
    "appId": "com.checkouai.copilot",
    "productName": "Checkou AI Copilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "keywords": ["interview", "ai", "copilot", "electron", "stealth"],
  "author": "Akash",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
